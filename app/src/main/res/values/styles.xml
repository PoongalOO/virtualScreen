<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Thème framework classique (pas d'AndroidX/AppCompat) : disponible sur API 17,
      conforme à la contrainte "Android Views classiques" (AGENTS.md / ARCHITECTURE.md).
      Sombre (Holo) : les écrans ont un fond sombre et des textes clairs (SS-050), et les champs de saisie, boutons,
      listes et boîtes de dialogue héritent ainsi de couleurs lisibles dessus.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Holo">
        <!-- Le layout racine peint déjà son propre fond ; évite le double
             remplissage relevé par Lint (Overdraw). -->
        <item name="android:windowBackground">@null</item>
    </style>

    <!-- Écran distant (SS-030) : plein écran (barre d'état masquée), sans barre d'action, fond noir pour
         qu'aucun flash blanc n'apparaisse avant le premier rendu. Thème framework, disponible en API 17. -->
    <style name="RemoteTheme" parent="@android:style/Theme.Holo.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
