<?xml version="1.0" encoding="utf-8"?>
<!-- SS-052, SS-053 : écran distant, fusionné dans le FrameLayout de contenu de l'activité (setContentView). La surface prend tout l'écran (le fond noir vient du thème RemoteTheme) ; la barre de commandes (en haut) et le panneau d'état
     (au centre) sont des vues ordinaires posées par-dessus, masquées par défaut. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <fr.webinfoconcept.secondscreen.render.RemoteSurfaceView
        android:id="@+id/remote_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Conteneur du haut : la barre de commandes puis la rangée de touches spéciales. -->
    <LinearLayout
        android:id="@+id/remote_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <!-- Barre de commandes : Retour ou tap à trois doigts l'affiche/la masque. Le pointeur est réservé à SS-045 :
             désactivé tant que cette issue n'est pas faite. -->
        <LinearLayout
            android:id="@+id/remote_bar"
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bar"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone">

            <Button
                android:id="@+id/bar_keyboard"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bar_keyboard" />

            <Button
                android:id="@+id/bar_pointer"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bar_pointer_direct" />

            <Button
                android:id="@+id/bar_diagnostic"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bar_diagnostic" />

            <Button
                android:id="@+id/bar_scale"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bar_scale_native" />

            <Button
                android:id="@+id/bar_fullscreen"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bar_fullscreen" />

            <Button
                android:id="@+id/bar_disconnect"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bar_disconnect" />
        </LinearLayout>


        <!-- Sensibilité du touchpad (SS-045) : visible avec la barre de commandes, en mode touchpad seulement. -->
        <LinearLayout
            android:id="@+id/remote_sensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/sensitivity_seek"
                android:text="@string/sensitivity_label"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/sensitivity_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/sensitivity_value"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Touches spéciales (SS-047) : visible tant que le mode clavier est actif. Ctrl, Alt et Maj sont des bascules
             « à un coup » : enfoncées jusqu'à la prochaine frappe. -->
        <LinearLayout
            android:id="@+id/remote_keys"
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bar"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone">

            <Button
                android:id="@+id/key_escape"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/keys_escape" />

            <Button
                android:id="@+id/key_tab"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/keys_tab" />

            <ToggleButton
                android:id="@+id/key_ctrl"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textOff="@string/keys_ctrl"
                android:textOn="@string/keys_ctrl" />

            <ToggleButton
                android:id="@+id/key_alt"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textOff="@string/keys_alt"
                android:textOn="@string/keys_alt" />

            <ToggleButton
                android:id="@+id/key_shift"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textOff="@string/keys_shift"
                android:textOn="@string/keys_shift" />

            <Button
                android:id="@+id/key_delete"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/keys_delete" />

            <Button
                android:id="@+id/key_backspace"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/keys_backspace" />

            <Button
                android:id="@+id/key_enter"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/keys_enter" />

            <Button
                android:id="@+id/key_left"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/keys_left" />

            <Button
                android:id="@+id/key_up"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/keys_up" />

            <Button
                android:id="@+id/key_down"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/keys_down" />

            <Button
                android:id="@+id/key_right"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/keys_right" />

            <Button
                android:id="@+id/key_hide"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/keys_hide" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cible du clavier virtuel (SS-046) : invisible, 1 dp, reçoit le focus quand le mode clavier s'active. -->
    <fr.webinfoconcept.secondscreen.input.KeyboardInputView
        android:id="@+id/remote_keyboard"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="bottom|start" />

    <!-- Mesures de performance (SS-060) : bandeau de chiffres en haut à gauche, visible seulement si activé. -->
    <TextView
        android:id="@+id/remote_perf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="#B0000000"
        android:fontFamily="monospace"
        android:padding="4dp"
        android:textColor="#80FF80"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- État de la connexion (SS-053) et reconnexion (SS-054). Visible tant que la session n'est pas établie. -->
    <LinearLayout
        android:id="@+id/remote_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/panel"
        android:minWidth="420dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/remote_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="520dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <ProgressBar
            android:id="@+id/remote_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/remote_reconnect"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/remote_reconnect" />

            <Button
                android:id="@+id/remote_stop_auto"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reconnect_stop"
                android:visibility="gone" />

            <Button
                android:id="@+id/remote_close"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/remote_close" />
        </LinearLayout>
    </LinearLayout>
</merge>
