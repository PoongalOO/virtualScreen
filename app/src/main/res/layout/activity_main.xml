<?xml version="1.0" encoding="utf-8"?>
<!-- SS-001 : écran placeholder minimal, valide uniquement le smoke test de
     compilation/installation. Les écrans fonctionnels arrivent avec SS-050
     (connexion) et SS-003 (diagnostic). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/main_status_title"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/text_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Accès provisoire à l'écran de diagnostic (SS-003) : ce bouton sera
         déplacé dans la barre de commandes distante par SS-052. -->
    <Button
        android:id="@+id/btn_diagnostic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/main_open_diagnostic" />

    <!-- Accès provisoire à l'écran de rendu (SS-030) : remplacé par l'écran de connexion (SS-050). -->
    <Button
        android:id="@+id/btn_render_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/main_open_render_test" />

</LinearLayout>
