<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SS-010 : connexion TCP vers le serveur VNC (RfbSocket). Seule permission demandée. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Pas de android:screenOrientation : l'orientation reste libre, donc le
                 mode paysage est disponible (critère SS-001). Lint (LockedOrientationActivity)
                 déconseille même la valeur explicite "unspecified". Le mode paysage forcé
                 plein écran est traité par SS-032/SS-034 sur l'écran distant, pas ici. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SS-050 : écran de connexion, non exporté. Le clavier ne doit pas masquer le formulaire. -->
        <activity
            android:name=".ConnectActivity"
            android:label="@string/connect_button"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- SS-003 : écran de diagnostic, pas de intent-filter -> exported=false
             implicite, non accessible depuis l'extérieur de l'app. -->
        <activity
            android:name=".DiagnosticActivity"
            android:label="@string/diagnostic_title" />

        <!-- Écran distant plein écran, non exporté (SS-030). Paysage forcé (F03) : c'est un moniteur 1280×800 fixe,
             pas une interface adaptative, donc l'avertissement Lint sur l'orientation verrouillée ne s'applique pas.
             sensorLandscape autorise les deux paysages : la tablette peut être posée dans les deux sens.
             windowSoftInputMode : le clavier virtuel se pose PAR-DESSUS l'écran distant sans le redimensionner (une
             SurfaceView redimensionnée rognerait l'image).
             configChanges : retourner la tablette (paysage <-> paysage inversé) ne recrée pas l'activité, donc ne coupe
             pas la session. -->
        <activity
            android:name=".RemoteActivity"
            android:label="@string/remote_title"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/RemoteTheme"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
    </application>
</manifest>
